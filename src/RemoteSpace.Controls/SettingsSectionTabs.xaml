<UserControl x:Class="RemoteSpace.Controls.SettingsSectionTabs" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RemoteSpace.Controls">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TabView x:Name="Tabs" Height="48" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" AutomationProperties.Name="PC settings sections" />
    <local:SemanticLayoutHost x:Name="SectionHost" Grid.Row="1" AutomationProperties.Name="Selected PC settings" />
  </Grid>
</UserControl>
