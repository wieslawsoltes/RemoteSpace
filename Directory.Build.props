<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-alpha.1</Version>
    <Authors>RemoteSpace contributors</Authors>
    <RepositoryUrl>https://github.com/wieslawsoltes/RemoteSpace</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Independent, experimental RemoteSpace remote desktop components. See the compatibility matrix before use.</Description>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
