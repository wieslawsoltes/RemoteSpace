<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>RemoteSpace</ApplicationTitle>
    <ApplicationId>org.remotespace.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RemoteSpace.Controls/RemoteSpace.Controls.csproj" />
    <ProjectReference Include="../../src/RemoteSpace.Workspace/RemoteSpace.Workspace.csproj" />
    <ProjectReference Include="../../src/RemoteSpace.Transport/RemoteSpace.Transport.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <ProjectReference Include="../../src/RemoteSpace.Client/RemoteSpace.Client.csproj" />
    <!-- Override affected transitive desktop-host dependencies; do not suppress audit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
