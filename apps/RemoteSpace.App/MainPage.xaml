<Page x:Class="RemoteSpace.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:RemoteSpace.Controls" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Padding="20,12" ColumnDefinitions="Auto,*,Auto">
      <FontIcon Glyph="&#xE8AF;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
      <TextBlock Grid.Column="1" Text="RemoteSpace" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" Text="Independent RDP client · Preview" Opacity="0.6" VerticalAlignment="Center" />
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" SelectionChanged="NavigationChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Devices" Tag="devices" Icon="AllApps" IsSelected="True" />
        <NavigationViewItem Content="Favorites" Tag="favorites" Icon="Favorite" />
        <NavigationViewItem Content="Active sessions" Tag="sessions" Icon="Remote" />
        <NavigationViewItem Content="Apps" Tag="apps" Icon="Library" />
      </NavigationView.MenuItems>
      <Grid Padding="28,20,28,16" RowDefinitions="Auto,Auto,*">
        <TextBlock x:Name="Heading" Text="Devices" FontSize="28" FontWeight="SemiBold" />
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,16,0,12" />
        <Grid Grid.Row="2">
          <Grid x:Name="DevicePanel" RowDefinitions="Auto,Auto,*">
            <Grid Margin="0,20,0,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBox x:Name="Search" PlaceholderText="Search devices" AutomationProperties.Name="Search devices" TextChanged="SearchChanged" MaxWidth="440" HorizontalAlignment="Left" MinWidth="220" />
              <Button Grid.Column="1" Content="Import .rdp" Click="ImportRdp" />
              <Button Grid.Column="2" Content="＋ Add PC" Click="AddPc" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
              <TextBlock x:Name="DeviceCount" Text="Saved PCs" VerticalAlignment="Center" />
              <ComboBox x:Name="Sort" AutomationProperties.Name="Sort devices" SelectedIndex="0" SelectionChanged="SortChanged"><ComboBoxItem Content="Name" /><ComboBoxItem Content="Group" /><ComboBoxItem Content="Recently used" /></ComboBox>
              <ToggleSwitch x:Name="ListMode" Header="List view" Toggled="ListModeChanged" />
            </StackPanel>
            <Grid Grid.Row="2">
              <GridView x:Name="Devices" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
                <GridView.ItemTemplate><DataTemplate><controls:DeviceCard Profile="{Binding Profile}" ActionRequested="DeviceAction" Margin="0,0,12,12" /></DataTemplate></GridView.ItemTemplate>
              </GridView>
              <ListView x:Name="DeviceList" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DeviceListClicked">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="12" ColumnDefinitions="*,*,Auto" ColumnSpacing="20"><TextBlock Text="{Binding Profile.Name}" /><TextBlock Grid.Column="1" Text="{Binding Profile.Host}" Opacity="0.7" /><TextBlock Grid.Column="2" Text="Connect  →" /></Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="480">
                <FontIcon Glyph="&#xE7F4;" FontSize="72" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="Your PCs, in one place" FontSize="22" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="Add a PC or import an .rdp file to get started. Connections use your own authorized remote desktop hosts." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
                <Button Content="Add your first PC" HorizontalAlignment="Center" Click="AddPc" />
              </StackPanel>
            </Grid>
          </Grid>
          <TabView x:Name="Sessions" Visibility="Collapsed" IsAddTabButtonVisible="False" TabCloseRequested="CloseSession" SelectionChanged="SessionSelectionChanged" />
          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel x:Name="SettingsBody" Spacing="16" MaxWidth="720" HorizontalAlignment="Left" /></ScrollViewer>
          <StackPanel x:Name="AppsPanel" Visibility="Collapsed" Spacing="16" MaxWidth="650" HorizontalAlignment="Left" Margin="0,24,0,0">
            <TextBlock Text="Remote apps and cloud workspaces" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="RemoteApp, Windows 365, Azure Virtual Desktop, and Microsoft account workspace discovery are not implemented in this preview. Adding a local PC does not subscribe to these services." TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>
    </NavigationView>
    <TextBlock x:Name="Status" Grid.Row="2" Padding="20,8" Text="Loading saved devices…" FontSize="12" Opacity="0.7" />
  </Grid>
</Page>
